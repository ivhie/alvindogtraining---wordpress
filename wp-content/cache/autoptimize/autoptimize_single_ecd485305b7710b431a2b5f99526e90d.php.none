jQuery(document).ready(function($){document.addEventListener('gesturestart',function(e){e.preventDefault();});var $hamburger=$(".hamburger");$hamburger.on("click touchstart",function(e){$hamburger.toggleClass("is-active");});$(window).resize(function(){var viewport=$(window).width();if(viewport>1160){var $hamburger=$('.hamburger');$hamburger.removeClass('is-active');$.slidebars.close();}});$('#sb-site').on('touchend click',function(event){var $hamburger=$(".hamburger");$hamburger.removeClass('is-active');});});