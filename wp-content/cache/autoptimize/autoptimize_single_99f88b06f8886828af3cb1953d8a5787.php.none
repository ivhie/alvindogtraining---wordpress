jQuery(document).ready(function($){var matched,browser;jQuery.uaMatch=function(ua){ua=ua.toLowerCase();var match=/(chrome)[ \/]([\w.]+)/.exec(ua)||/(webkit)[ \/]([\w.]+)/.exec(ua)||/(opera)(?:.*version|)[ \/]([\w.]+)/.exec(ua)||/(msie) ([\w.]+)/.exec(ua)||ua.indexOf("compatible")<0&&/(mozilla)(?:.*? rv:([\w.]+)|)/.exec(ua)||[];return{browser:match[1]||"",version:match[2]||"0"};};matched=jQuery.uaMatch(navigator.userAgent);browser={};if(matched.browser){browser[matched.browser]=true;browser.version=matched.version;}
if(browser.chrome){browser.webkit=true;}else if(browser.webkit){browser.safari=true;}
jQuery.browser=browser;$(window).scroll(function(){if($(this).scrollTop()>50){$('body').addClass('gsticky');}else{$('body').removeClass('gsticky');}});$('.site-header ul.sf-menu').superfish({animation:{opacity:'show',height:'show'},delay:1000,speed:'normal',autoArrows:false,});$('#mobile-menu .menu-item-has-children').each(function(index,el){$(this).prepend('<span class="caret"></span>');});$('#mobile-menu > li > .caret').on('click',function(event){event.preventDefault();$('#mobile-menu > li > .sub-menu').not($(this).siblings('.sub-menu').slideToggle()).hide('slide');$('#mobile-menu > li').not($(this).parent().toggleClass('par-active')).removeClass('par-active');});$('#mobile-menu .sub-menu > li > .caret').on('click',function(event){event.preventDefault();$('#mobile-menu .sub-menu li > .sub-menu').not($(this).siblings('.sub-menu').slideToggle()).hide('slide');$('#mobile-menu .sub-menu > li').not($(this).parent().toggleClass('par-active')).removeClass('par-active');});$('.popup-media-toggle').magnificPopup({type:'inline',preloader:false,focus:''});$('.has-lity .sow-image-container img').each(function(){$(this).closest(".has-lity a").attr('data-lity','true');$(this).closest(".has-lity a").css('border','0px solid red');$(this).closest(".has-lity").removeClass('lity');})
if($('#back-top').length){var scrollTrigger=300,backToTop=function(){var scrollTop=$(window).scrollTop();if(scrollTop>scrollTrigger){$('#back-top').addClass('show');}else{$('#back-top').removeClass('show');}};backToTop();$(window).on('scroll',function(){backToTop();});$('#back-top').on('click',function(e){e.preventDefault();$('html,body').animate({scrollTop:0},700);});}
$.slidebars({disableOver:2000});$("#masthead").mouseenter(function(){}).mouseleave(function(){});});jQuery(document).ready(function($){$('.get-image-url img').each(function(){$(this).closest(".add-image-here").css('background-image','url('+$(this).attr('src')+')');imgWidth=$(this).width();imgHeight=$(this).height();$(this).closest(".add-image-here").css('background-size',imgWidth+'px'+' '+imgHeight+'px');$(this).closest(".add-image-here").css('background-repeat','no-repeat');$(this).closest(".add-image-here img").css('visibility','hidden');$(this).closest(".add-image-here img").css('width',imgWidth+'px');$(this).closest(".add-image-here img").css('height',imgHeight+'px');})
$('.get-image-url-2 img').each(function(){$(this).closest(".add-image-here").css('background-image','url('+$(this).attr('src')+')');imgWidth=$(this).width();imgHeight=$(this).height();$(this).closest(".add-image-here").css('background-size','cover');$(this).closest(".add-image-here").css('background-repeat','no-repeat');$(this).closest(".add-image-here img").css('visibility','hidden');$(this).closest(".add-image-here img").css('width',imgWidth+'px');$(this).closest(".add-image-here img").css('height',imgHeight+'px');})
viewportWidth=$(document).width();if(viewportWidth<=680){$(".add-image-here img").attr('style','');}
jQuery('.remove-trigger').removeClass('everlightbox-trigger');});